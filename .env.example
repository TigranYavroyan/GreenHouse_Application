# Copy to `.env` in the repository root (same folder as `docker-compose.yml`).
# All Docker Compose files use `env_file: ./.env` for services that need secrets or tuning.
# For local development without Compose, backend and frontend load this file when it sits
# next to `docker-compose.yml`. Compose may override hostnames (e.g. REDIS_HOST=redis) per service.

# --- Backend (Node) ---
NODE_ENV=development
PORT=3000
HTTP_LISTEN_HOST=0.0.0.0

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ERROR_LOG_INTERVAL_MS=10000
REDIS_RECONNECT_BACKOFF_BASE_MS=500
REDIS_RECONNECT_BACKOFF_MAX_MS=10000

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_RECONNECT_DELAY_MS=5000
RABBITMQ_BOOTSTRAP_RETRY_DELAY_MS=5000

EXEC_TIMEOUT_MS=15000

POSTGRES_HOST=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=greenhouse
POSTGRES_PORT=5432

GREENHOUSE_CORE_URL=http://127.0.0.1:3001
GREENHOUSE_CORE_TIMEOUT=10000
GREENHOUSE_CORE_RETRIES=2
GREENHOUSE_CORE_RETRY_BACKOFF_BASE_MS=100

SESSION_CLEANUP_INTERVAL_MS=300000
SESSION_INACTIVITY_TTL_MS=1800000
PROM_DEFAULT_METRICS_TIMEOUT_MS=5000
SENSOR_READINGS_MAX_LIMIT=5000
FOG_REDIS_SCAN_COUNT=100
FOG_ANOMALY_TTL_SEC=86400
FOG_ANOMALY_RECENT_LIST_MAX_INDEX=99

JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1h
EMAIL_VERIFICATION_JWT_SECRET=replace_with_secure_secret
EMAIL_VERIFICATION_EXPIRES_IN=1h
PUBLIC_BACKEND_URL=http://0.0.0.0:3000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@gmail.com
SMTP_PASS=app_password
MAIL_FROM=Greenhouse Automation <example@gmail.com>
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY_MS=30000

# --- Desktop (PyQt) ---
# Local: http://127.0.0.1:3000 ; Docker desktop: http://backend:3000
BACKEND_URL=http://0.0.0.0:3000
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

REDIS_DB=0

PENDING_COMMAND_TIMEOUT_MS=30000
PENDING_COMMAND_POLL_MS=1000
RABBIT_CONNECTION_CHECK_INTERVAL_MS=10000
EDGE_FOG_CLEANUP_INTERVAL_MS=300000
EDGE_AGGREGATION_INTERVAL_MS=60000
EDGE_FOG_SENSOR_SIM_INTERVAL_MS=5000
EDGE_FOG_REDIS_CACHE_TTL_SEC=600
EDGE_FOG_EXAMPLE_DEVICE_IPS=192.168.1.101,192.168.1.102,192.168.1.103

# --- Core simulator (FastAPI); avoids clashing with backend PORT ---
SIM_PORT=3001
SIM_LOGS_DIR=/app/logs
