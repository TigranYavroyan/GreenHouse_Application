classDiagram
    %% Frontend Classes
    class GreenhouseDesktop {
        -UUID session_id
        -Dict pending_commands
        -String backend_url
        -EdgeToFogAggregator edge_aggregator
        -RedisEdgeClient redis_edge_client
        -CommandWorker command_worker
        +setupUI()
        +send_user_command(command, params)
        +handle_response(response)
        +check_server_health()
        +view_server_stats()
    }
    
    class CommandWorker {
        -pika.Connection connection
        -pika.Channel channel
        -Dict pending_commands
        +setup_rabbitmq()
        +send_command(command_data)
        +_check_for_messages()
        +disconnect()
    }
    
    class EdgeToFogAggregator {
        -Dict raw_data_buffer
        -Dict aggregated_data
        -Dict edge_devices
        -List anomalies
        +register_edge_device()
        +add_sensor_reading(reading)
        +run_periodic_aggregation()
        +detect_anomalies()
        +get_aggregated_metrics()
    }
    
    class RedisEdgeClient {
        -redis.Redis redis_client
        +get(key) Any
        +set(key, value, ttl)
        +delete(key)
        +clear_namespace(namespace)
    }
    
    %% Backend Classes
    class App {
        -express.Application app
        -RedisClientWrapper redisClient
        -RabbitMQClient rabbitClient
        -GreenhouseCoreClient greenhouseCoreClient
        -SessionManager sessionManager
        -CommandExecutor commandExecutor
        -CommandProcessor commandProcessor
        +setupMiddleware()
        +setupRoutes()
        +setupRabbitAndConsumer()
        +start(port)
    }
    
    class CommandProcessor {
        -RedisClientWrapper redis
        -SessionManager sessions
        -RabbitMQClient rabbit
        -CommandExecutor executor
        -Object commandStats
        +processCommand(commandData) Promise
        +generateCacheKey() String
        +isStateful(command) Boolean
        +getTTLForCommand(command) int
    }
    
    class CommandExecutor {
        -SystemLogger systemLogger
        -GreenhouseCoreClient greenhouseCoreClient
        +runCommand(command, params, session) Promise
        +executeGreenhouseCommand(command, params, session) Promise
        +isGreenhouseCommand(command) Boolean
    }
    
    class SessionManager {
        -Map~String,Session~ sessions
        -int counter
        +createSession(sessionId) Session
        +getSession(sessionId) Session
        +getOrCreate(sessionId) Session
        +cleanupOldSessions()
    }
    
    class Session {
        +String sessionId
        +int sessionNumber
        +String currentPath
        +String createdAt
        +String lastActivity
        +String lastCommandId
        +Promise commandQueue
        +SessionLogger logger
    }
    
    class RedisClientWrapper {
        -redis.Client client
        -Boolean isOpen
        +connect()
        +get(key) Promise~String~
        +setEx(key, ttl, value) Promise
        +del(keys) Promise
        +keys(pattern) Promise~Array~
    }
    
    class RabbitMQClient {
        -amqp.Connection connection
        -amqp.Channel channel
        +connect()
        +assertQueue(queue, options) Promise
        +sendToQueue(queue, message, options) Promise
        +consume(queue, callback, options) Promise
        +ack(message) Promise
    }
    
    class GreenhouseCoreClient {
        -String baseUrl
        -int timeout
        -int maxRetries
        -Boolean isConnected
        +connect() Promise
        +disconnect() Promise
        +executeCommand(command, params, metadata) Promise
        +healthCheck() Promise
        +get connected() Boolean
    }
    
    %% Data Models
    class SensorReading {
        +String device_id
        +SensorType sensor_type
        +float value
        +DateTime timestamp
        +String location
        +float quality
        +float battery_level
        +float signal_strength
    }
    
    class AggregatedData {
        +String timeframe
        +SensorType sensor_type
        +float average
        +float min
        +float max
        +int count
        +float std_dev
        +DateTime timestamp
        +float quality_score
        +String location
    }
    
    class CommandData {
        +UUID commandId
        +String command
        +Object parameters
        +String sessionId
        +String type
    }
    
    class CommandResponse {
        +UUID commandId
        +Object result
        +Boolean cached
        +String sessionId
        +DateTime timestamp
        +String error
    }
    
    %% Relationships
    GreenhouseDesktop *-- CommandWorker : contains
    GreenhouseDesktop *-- EdgeToFogAggregator : contains
    GreenhouseDesktop *-- RedisEdgeClient : contains
    EdgeToFogAggregator --> RedisEdgeClient : uses
    
    App *-- RedisClientWrapper : contains
    App *-- RabbitMQClient : contains
    App *-- GreenhouseCoreClient : contains
    App *-- SessionManager : contains
    App *-- CommandExecutor : contains
    App *-- CommandProcessor : contains
    
    CommandProcessor --> RedisClientWrapper : uses
    CommandProcessor --> SessionManager : uses
    CommandProcessor --> RabbitMQClient : uses
    CommandProcessor --> CommandExecutor : uses
    
    CommandExecutor --> GreenhouseCoreClient : uses
    
    SessionManager *-- Session : manages
    
    EdgeToFogAggregator --> SensorReading : creates
    EdgeToFogAggregator --> AggregatedData : creates
    CommandWorker --> CommandData : creates
    CommandProcessor --> CommandResponse : creates
    
    %% Simulator Classes
    class DeviceSimulator {
        -Object deviceStates
        -Object sensorData
        +readTemperatureData() Object
        +readHumidityData() Object
        +readLightData() Object
        +readCO2Data() Object
        +readSoilMoistureData() Object
        +readSoilPHData() Object
        +switchWaterCanal(action) Object
        +switchActuator(actuatorId, action) Object
        +switchFan(fanId, action) Object
        +switchHeater(heaterId, action) Object
        +getDeviceStates() Object
        +getSensorData() Object
    }
    
    class CommandController {
        -DeviceSimulator simulator
        +executeCommand(req, res)
        +healthCheck(req, res)
        +getDeviceStates(req, res)
    }





    %% ============================================
    classDef level1 fill:#1e3a8a,stroke:#3b82f6,stroke-width:3px,color:#fff,font-size:14px
    classDef level2 fill:#7c2d12,stroke:#ea580c,stroke-width:2px,color:#fff,font-size:12px
    classDef kafka fill:#78350f,stroke:#fbbf24,stroke-width:4px,color:#fff,font-size:14px
    classDef redis fill:#7c1d1d,stroke:#dc2626,stroke-width:4px,color:#fff,font-size:14px
    classDef level4 fill:#581c87,stroke:#a855f7,stroke-width:2px,color:#fff,font-size:11px
    classDef level5 fill:#14532d,stroke:#22c55e,stroke-width:2px,color:#fff,font-size:12px
    classDef monitoring fill:#831843,stroke:#ec4899,stroke-width:2px,color:#fff,font-size:11px
    
    %% Apply styles
    class Nginx level1
    class APIGateway,SSEWSGateway level2
    class Grafana,Prometheus monitoring
    class Kafka kafka
    class Redis redis
    class UserService,GameService,PaymentService,OwnerService,NotificationService,RoomService,ChessEngine,SearchService level4
    class DatabaseLayer,MongoDB,PostgreSQL level5
    
    %% Subgraph styling - visible borders for hierarchy
    style L1 fill:#eff6ff,stroke:#3b82f6,stroke-width:3px,stroke-dasharray: 5 5
    style L2 fill:#fff7ed,stroke:#ea580c,stroke-width:2px,stroke-dasharray: 5 5
    style L3 fill:transparent,stroke:transparent,stroke-width:0px
    style KAFKA_CLUSTER fill:#fef3c7,stroke:#fbbf24,stroke-width:4px,stroke-dasharray: 8 4
    style REDIS_CLUSTER fill:#fee2e2,stroke:#dc2626,stroke-width:4px,stroke-dasharray: 8 4
    style L4 fill:#faf5ff,stroke:#a855f7,stroke-width:2px,stroke-dasharray: 5 5
    style L5 fill:#f0fdf4,stroke:#22c55e,stroke-width:2px,stroke-dasharray: 5 5
    style LEFT_GW fill:#fff7ed,stroke:#ea580c,stroke-width:1px
    style RIGHT_GW fill:#fff7ed,stroke:#ea580c,stroke-width:1px
    style MON_LEFT fill:#fce7f3,stroke:#ec4899,stroke-width:1px
    style LEFT_SERVICES fill:#faf5ff,stroke:#a855f7,stroke-width:1px
    style RIGHT_SERVICES fill:#faf5ff,stroke:#a855f7,stroke-width:1px
    style DATABASES fill:#f0fdf4,stroke:#22c55e,stroke-width:1px
