classDiagram
    class GreenhouseDesktop
    class CommandWorker
    class EdgeToFogAggregator
    class RedisEdgeClient
    class CoreApiClient

    class App
    class RabbitMQClient
    class RedisClientWrapper
    class GreenhouseCoreClient
    class SessionManager
    class CommandProcessor
    class CommandExecutor
    class SchedulesRuntime
    class NotificationConsumer

    class UserEntity
    class DeviceEntity
    class SensorEntity
    class SensorReadingEntity
    class ActuatorEntity
    class ScheduleEntity
    class SensorAlertRuleEntity
    class SensorAlertEntity
    class UserLogEntity

    GreenhouseDesktop *-- CommandWorker
    GreenhouseDesktop *-- CoreApiClient
    GreenhouseDesktop *-- EdgeToFogAggregator
    GreenhouseDesktop *-- RedisEdgeClient

    App *-- RabbitMQClient
    App *-- RedisClientWrapper
    App *-- GreenhouseCoreClient
    App *-- SessionManager
    App *-- CommandProcessor
    App *-- CommandExecutor
    App *-- SchedulesRuntime
    App *-- NotificationConsumer

    CommandProcessor --> SessionManager
    CommandProcessor --> RedisClientWrapper
    CommandProcessor --> CommandExecutor
    CommandExecutor --> GreenhouseCoreClient
    SchedulesRuntime --> RabbitMQClient

    UserEntity --> DeviceEntity : hasMany
    UserEntity --> UserLogEntity : hasMany
    DeviceEntity --> SensorEntity : hasMany
    DeviceEntity --> ActuatorEntity : hasMany
    DeviceEntity --> ScheduleEntity : hasMany
    SensorEntity --> SensorReadingEntity : hasMany
    SensorEntity --> SensorAlertRuleEntity : hasMany
    SensorAlertRuleEntity --> SensorAlertEntity : hasMany
