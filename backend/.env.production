# Production Environment Configuration
NODE_ENV=production
PORT=3000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Execution Configuration
EXEC_TIMEOUT_MS=15000

POSTGRES_HOST=postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=greenhouse
POSTGRES_PORT=5432

# Secrets
JWT_SECRET=your_jwt_secretw
JWT_EXPIRES_IN=1h

# Default desktop user bootstrap (set enabled=true only when needed)
DEFAULT_USER_ENABLED=false
DEFAULT_USER_USERNAME=desktop_default_user
DEFAULT_USER_PASSWORD=replace_with_strong_password
DEFAULT_USER_EMAIL=