# Development Environment Configuration
NODE_ENV=development
PORT=3000

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Execution Configuration
EXEC_TIMEOUT_MS=15000

# Postgres
POSTGRES_HOST=postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=greenhouse
POSTGRES_PORT=5432

# Secrets
JWT_SECRET=your_jwt_secretw
JWT_EXPIRES_IN=1h
EMAIL_VERIFICATION_JWT_SECRET=your_email_verification_secret
EMAIL_VERIFICATION_EXPIRES_IN=1h
PUBLIC_BACKEND_URL=http://localhost:3000

# Notification email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@gmail.com
SMTP_PASS=app_password
MAIL_FROM=Greenhouse Automation <example@gmail.com>
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY_MS=30000