# Copy this file to .env.development or .env.production
# and adjust values for your environment.

NODE_ENV=development
PORT=3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Execution Configuration
EXEC_TIMEOUT_MS=15000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=greenhouse
POSTGRES_PORT=5432

# Greenhouse Core
GREENHOUSE_CORE_URL=http://localhost:3001
GREENHOUSE_CORE_TIMEOUT=10000
GREENHOUSE_CORE_RETRIES=2

# Secrets
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1h
EMAIL_VERIFICATION_JWT_SECRET=replace_with_secure_secret
EMAIL_VERIFICATION_EXPIRES_IN=1h

# Public URL used in verification links
PUBLIC_BACKEND_URL=http://localhost:3000

# Notification email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@gmail.com
SMTP_PASS=app_password
MAIL_FROM=Greenhouse Automation <example@gmail.com>
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_DELAY_MS=30000
