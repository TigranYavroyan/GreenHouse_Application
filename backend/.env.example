# Copy this file to .env.development or .env.production
# and adjust values for your environment.

NODE_ENV=development
PORT=3000

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# Execution Configuration
EXEC_TIMEOUT_MS=15000

# Postgres
POSTGRES_HOST=localhost
POSTGRES_USER=user
POSTGRES_PASSWORD=user
POSTGRES_DB=greenhouse
POSTGRES_PORT=5432

# Greenhouse Core
GREENHOUSE_CORE_URL=http://localhost:3001
GREENHOUSE_CORE_TIMEOUT=10000
GREENHOUSE_CORE_RETRIES=2

# Secrets
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=1h

# Default desktop user bootstrap (set enabled=true only when needed)
DEFAULT_USER_ENABLED=false
DEFAULT_USER_USERNAME=desktop_default_user
DEFAULT_USER_PASSWORD=replace_with_strong_password
DEFAULT_USER_EMAIL=
