  <property name="windowTitle">
   <string>🌿 Greenhouse Automation Control System</string>
  </property>
  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #0B1020;
    color: #E7E9EE;
    font-family: Segoe UI, Roboto, Arial, sans-serif;
    font-size: 12px;
}

QWidget#centralwidget {
    background-color: #0B1020;
    color: #E7E9EE;
}

QWidget#userTab,
QWidget#schedulingTab,
QWidget#serverTab,
QWidget#user_output_container,
QWidget#schedule_output_container,
QWidget#server_info_container,
QWidget#simpleDataTable {
    background-color: transparent;
}

QLabel {
    color: #E7E9EE;
}

QLabel#sessionTitleLabel,
QLabel#statusTitleLabel,
QLabel#scheduleHintLabel {
    color: #A3ADC2;
    font-size: 11px;
}

QLabel#session_label,
QLabel#connection_status,
QLabel#authUserLabel,
QLabel#status_label {
    color: #E7E9EE;
    background-color: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 8px;
    padding: 4px 8px;
}

QLabel#controlTableHintLabel,
QLabel#scheduleTableHintLabel,
QLabel#serverTableHintLabel {
    color: #A3ADC2;
    font-size: 11px;
    margin-top: 4px;
}

QGroupBox {
    background-color: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 12px;
    margin-top: 16px;
    padding-top: 8px;
    color: #E7E9EE;
    font-size: 14px;
    font-weight: 600;
}

QGroupBox#infoGroup {
    background-color: transparent;
    border: none;
    margin-top: 0px;
    padding-top: 0px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 4px 12px;
    background-color: rgba(255,255,255,0.10);
    color: #E7E9EE;
    border-radius: 6px;
}

QTabWidget::pane {
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 12px;
    background-color: rgba(255,255,255,0.06);
    margin-top: -1px;
}

QTabWidget::tab-bar {
    alignment: center;
}

QTabBar::tab {
    background-color: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.12);
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 7px 14px;
    margin-right: 4px;
    color: #A3ADC2;
    min-width: 90px;
}

QTabBar::tab:selected {
    background-color: rgba(255,255,255,0.12);
    color: #E7E9EE;
    border-color: rgba(255,255,255,0.20);
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255,255,255,0.10);
    color: #E7E9EE;
}

QPushButton {
    background-color: rgba(255,255,255,0.08);
    color: #E7E9EE;
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 10px;
    padding: 7px 12px;
    font-weight: 500;
    min-height: 22px;
}

QPushButton:hover {
    background-color: rgba(255,255,255,0.12);
}

QPushButton:pressed {
    background-color: rgba(255,255,255,0.18);
}

QPushButton:disabled {
    background-color: rgba(255,255,255,0.04);
    color: #6B7DA3;
    border-color: rgba(255,255,255,0.08);
}

QPushButton#clearCacheButton {
    background-color: #FF6B6B;
    color: #0B1020;
    border: none;
}

QPushButton#clearCacheButton:hover {
    background-color: #FF8585;
}

QPushButton#clearCacheButton:pressed {
    background-color: #E25555;
}

QPushButton#clearTableButton {
    background-color: #FF6B6B;
    color: #0B1020;
    border: none;
}

QPushButton#clearTableButton:hover {
    background-color: #FF8585;
}

QPushButton#clearTableButton:pressed {
    background-color: #E25555;
}

QPushButton#testCommandButton,
QPushButton#refreshButton,
QPushButton#logoutButton {
    background-color: rgba(255,255,255,0.05);
    border: 1px solid #6ECBFF;
    color: #9BD3FF;
}

QPushButton#testCommandButton:hover,
QPushButton#refreshButton:hover,
QPushButton#logoutButton:hover {
    background-color: rgba(110,203,255,0.15);
    color: #E7E9EE;
}

QLineEdit, QComboBox, QSpinBox {
    background-color: #131A2E;
    color: #E7E9EE;
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 10px;
    padding: 6px 10px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid rgba(110,203,255,0.8);
}

QComboBox {
    background-color: #131A2E;
    color: #E7E9EE;
    border: 1px solid #344266;
    border-radius: 10px;
    padding: 6px 10px 6px 8px;
}

QComboBox:hover {
    border: 1px solid #4B5C84;
}

QComboBox QAbstractItemView {
    background-color: #1A2238;
    color: #E7E9EE;
    border: 1px solid #344266;
    selection-background-color: #344266;
    selection-color: #E7E9EE;
    outline: 0;
}

QComboBox QAbstractItemView::item {
    color: #E7E9EE;
    background-color: transparent;
    border-bottom: 1px solid #344266;
    padding: 6px 8px;
}

QComboBox QAbstractItemView::item:hover {
    color: #E7E9EE;
    background-color: #344266;
    border: 1px solid #FFFFFF;
}

QComboBox QAbstractItemView::item:selected {
    color: #E7E9EE;
    background-color: #344266;
    border: 1px solid #FFFFFF;
}

QComboBox#scheduleTargetCombo,
QComboBox#scheduleDelayPresetCombo {
    background-color: #131A2E;
    color: #E7E9EE;
    border: 1px solid #344266;
    border-radius: 10px;
    padding: 6px 10px 6px 8px;
}

QComboBox#scheduleTargetCombo:hover,
QComboBox#scheduleDelayPresetCombo:hover {
    border: 1px solid #4B5C84;
}

QComboBox#scheduleTargetCombo QAbstractItemView,
QComboBox#scheduleDelayPresetCombo QAbstractItemView {
    background-color: #131A2E;
    color: #E7E9EE;
    border: 1px solid #344266;
    selection-background-color: #344266;
    selection-color: #E7E9EE;
    outline: 0;
}

QComboBox#scheduleTargetCombo QAbstractItemView::item,
QComboBox#scheduleDelayPresetCombo QAbstractItemView::item {
    border-bottom: 1px solid #344266;
    padding: 6px 8px;
}

QComboBox#scheduleTargetCombo QAbstractItemView::item:hover,
QComboBox#scheduleDelayPresetCombo QAbstractItemView::item:hover {
    color: #E7E9EE;
    background-color: #344266;
    border: 1px solid #344266;
}

QComboBox#scheduleTargetCombo QAbstractItemView::item:selected,
QComboBox#scheduleDelayPresetCombo QAbstractItemView::item:selected {
    color: #E7E9EE;
    background-color: #344266;
    border: 1px solid #344266;
}

QListView,
QMenu {
    background-color: #1A2238;
    color: #E7E9EE;
    border: 1px solid #344266;
}

QListView::item,
QMenu::item {
    color: #E7E9EE;
    background-color: transparent;
    padding: 6px 10px;
}

QListView::item:hover,
QMenu::item:selected {
    color: #E7E9EE;
    background-color: #344266;
}

QTableWidget {
    background-color: #131A2E;
    alternate-background-color: #1A2238;
    border: 1px solid #344266;
    border-radius: 10px;
    gridline-color: #344266;
    color: #E7E9EE;
    selection-background-color: rgba(155,211,255,0.78);
    selection-color: #0B1020;
}

QTableWidget::item {
    border-bottom: 1px solid rgba(255,255,255,0.06);
    padding: 6px;
}

QTableWidget::item:selected,
QTableWidget::item:selected:active,
QTableWidget::item:selected:!active {
    color: #0B1020;
    background-color: rgba(155,211,255,0.78);
    border: 1px solid #344266;
}

QTableWidget::item:hover {
    background-color: rgba(255,255,255,0.08);
}

QHeaderView::section {
    background-color: #9BD3FF;
    color: #0B1020;
    padding: 8px 10px;
    border: 1px solid #344266;
    border-right: 1px solid #344266;
    font-weight: 600;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

QScrollBar:vertical {
    background-color: #1A2238;
    width: 11px;
    margin: 2px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background-color: #344266;
    border-radius: 5px;
    min-height: 28px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4B5C84;
}

QScrollBar:horizontal {
    background-color: #1A2238;
    height: 11px;
    margin: 2px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background-color: #344266;
    border-radius: 5px;
    min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #4B5C84;
}</string>
