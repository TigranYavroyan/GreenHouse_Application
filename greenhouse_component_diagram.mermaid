graph TB
    subgraph "Presentation Layer"
        UI[UI Components]
        ControlTab[Control Panel]
        TerminalTab[Terminal Interface]
        ServerTab[Server Management]
        UI --> ControlTab
        UI --> TerminalTab
        UI --> ServerTab
    end
    
    subgraph "Communication Layer"
        MessageBus[Message Bus]
        Publisher[Message Publisher]
        Consumer[Message Consumer]
        MessageBus --> Publisher
        MessageBus --> Consumer
    end
    
    subgraph "Business Logic Layer"
        ProcessingCore[Processing Core]
        CommandProc[Command Processor]
        SessionMgmt[Session Management]
        CacheManager[Cache Manager]
        ProcessingCore --> CommandProc
        ProcessingCore --> SessionMgmt
        ProcessingCore --> CacheManager
    end
    
    subgraph "Execution Layer"
        Executor[Command Executor]
        ShellInterface[Shell Interface]
        SensorInterface[Sensor Interface]
        ActuatorInterface[Actuator Interface]
        Executor --> ShellInterface
        Executor --> SensorInterface
        Executor --> ActuatorInterface
    end
    
    subgraph "Edge Computing Layer"
        EdgeGateway[Edge Gateway]
        DataCollector[Data Collector]
        Aggregator[Data Aggregator]
        LocalCache[Local Cache]
        EdgeGateway --> DataCollector
        EdgeGateway --> Aggregator
        EdgeGateway --> LocalCache
    end
    
    subgraph "Data Layer"
        CacheStore[Cache Store<br/>Redis]
        MessageQueue[Message Queue<br/>RabbitMQ]
        LogStore[Log Storage<br/>File System]
        MetricsStore[Metrics Store<br/>Prometheus]
    end
    
    subgraph "Monitoring Layer"
        HealthCheck[Health Checker]
        MetricsCollector[Metrics Collector]
        AlertManager[Alert Manager]
        HealthCheck --> MetricsCollector
        MetricsCollector --> AlertManager
    end
    
    subgraph "Hardware Layer"
        Sensors[Physical Sensors]
        Actuators[Physical Actuators]
        Network[Network Infrastructure]
    end
    
    UI -->|Commands| Publisher
    Consumer -->|Responses| UI
    Publisher -->|AMQP| MessageQueue
    MessageQueue -->|AMQP| Consumer
    
    Consumer -->|Message| ProcessingCore
    ProcessingCore -->|Result| Publisher
    
    CommandProc -->|Check/Store| CacheManager
    CacheManager -->|Redis Ops| CacheStore
    
    CommandProc -->|Execute| Executor
    SessionMgmt -->|State| LogStore
    
    ShellInterface -->|System Calls| Network
    SensorInterface -->|Read| Sensors
    ActuatorInterface -->|Control| Actuators
    
    Sensors -->|Raw Data| DataCollector
    DataCollector -->|Samples| Aggregator
    Aggregator -->|Batches| Publisher
    Aggregator -->|Temporary| LocalCache
    
    ProcessingCore -->|Status| HealthCheck
    CacheStore -->|Status| HealthCheck
    MessageQueue -->|Status| HealthCheck
    
    Executor -->|Metrics| MetricsCollector
    CacheManager -->|Metrics| MetricsCollector
    MetricsCollector -->|Store| MetricsStore
    
    HealthCheck -->|Alerts| AlertManager
    
    style UI fill:#e1f5ff
    style ProcessingCore fill:#fff4e1
    style CacheStore fill:#ffe1e1
    style MessageQueue fill:#e1ffe1
    style EdgeGateway fill:#f0e1ff
    style HealthCheck fill:#ffffcc